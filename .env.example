# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com
LLM_PROVIDER=gemini          # or "fake" to run without a key (only knows the bundled samples)
EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=12

# Business rules
PRICE_TOLERANCE=0.02         # 2 % above PO price triggers review
VENDOR_MATCH_THRESHOLD=85    # fuzzy vendor-name similarity (0-100)

# Integrations (optional)
INGEST_API_KEY=              # send as X-API-Key from n8n/scripts to skip the public rate limit
APPROVAL_WEBHOOK_URL=        # POSTed on every approval (n8n, Zapier, Make, Slack...)
DEMO_RESET_ON_START=false
